@article{Kim2021,
   abstract = {The idea of a paperless office has gained popularity since the 1980s when dependence on computers led people to believe that the use of paper would become obsolete. On the contrary, the prevalence of computers has increased the amount of paper used in offices, rather than leading to its demise. Although the concept of a paperless office is rooted in an imagined conversion to an electronic society, there are also environmental impacts associated with this transformation. In this study, by applying life-cycle assessment (LCA) techniques, we explored environmental significance of a move toward the elimination of paper use in an office to compare the costs and impacts of paper use to a projected alternative scenario where an office-worker is equipped with a tablet laptop or slate, home and office monitors, and additional networking capabilities. An analysis based on one worker is extrapolated to a typical office-setting case study.},
   author = {Jinho Kim and Yonghee Kim and Soorim Oh and Taejin Kim and Dogyun Lee},
   doi = {10.22712/susb.20210005},
   issn = {20937628},
   issue = {1},
   journal = {International Journal of Sustainable Building Technology and Urban Development},
   keywords = {Environmental impact,Life-cycle assessment,Paperless office},
   pages = {44-60},
   publisher = {Sustainable Building Research Center},
   title = {Estimation of environmental impact of paperless office based on simple model scenarios},
   volume = {12},
   year = {2021}
}
